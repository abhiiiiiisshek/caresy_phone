# Google Play service account key used by `eas submit --platform android`.
# This key can publish to the production track, so it is a production
# credential, not config. It lives in credentials/ rather than android/
# because `expo prebuild` regenerates android/ and would delete it.
credentials/service-account.json
service-account.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
