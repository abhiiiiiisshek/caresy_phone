# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Phone (OTP) sign-in via MSG91. Leave the two NEXT_PUBLIC_ vars unset to hide
# the "Continue with phone number" button entirely.
# Widget ID and token auth come from MSG91 → OTP Widget → your widget.
NEXT_PUBLIC_MSG91_WIDGET_ID=your-msg91-widget-id
NEXT_PUBLIC_MSG91_TOKEN_AUTH=your-msg91-widget-token-auth
# Secret. Only /api/auth/phone uses it, to verify the widget's access-token.
MSG91_AUTHKEY=your-msg91-authkey
# Also secret. /api/auth/phone needs it to mint the session; the cron routes
# already use the same key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
